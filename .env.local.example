# Local development only — never commit this file.
# Copy to .env.local and fill in throwaway test values.

# Admin password used by /admin (local testing only).
ADMIN_PASSWORD=testpassword123

# Random string used to sign the admin session cookie (local testing only).
ADMIN_SESSION_SECRET=local-test-secret-change-me-in-production

# GitHub token for the admin publish feature (leave empty to test the
# "not configured" error path; a real token is only needed on Vercel).
GITHUB_TOKEN=

# --- Marketplace (Supabase + Paystack + Resend) ---
# From your Supabase project: Settings -> API. Without these, the
# marketplace shows clearly-labelled demo listings instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (SECRET — server only, never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (required for card checkout) ---
# Use TEST keys first (pk_test_... / sk_test_...). Go live only after CAC
# registration is complete — Paystack needs it to verify the business.
PAYSTACK_SECRET_KEY=

# --- App URL (used for the Paystack callback after payment) ---
NEXT_PUBLIC_APP_URL=https://www.greennesthub.com.ng

# --- Resend (order confirmation emails — optional) ---
# Create an API key at resend.com (free tier is enough to start).
# Without it the app still builds and runs; order emails are just skipped.
# EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Greennest Hub <orders@joetech360.ng>
